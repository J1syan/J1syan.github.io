---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { categoryUrl, getPublishedPosts, postUrl, tagUrl, estimateReadingTime } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="全部文章" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<p class="eyebrow">{SITE_TITLE}</p>
				<h1>全部文章</h1>
				<p>按发布时间整理，共 {posts.length} 篇。</p>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={postUrl(post)}>
								<div class="card-content">
									<h2>
										{post.data.title}
										{post.data.password && <span class="lock-badge" title="加密文章">&#128274;</span>}
									</h2>
									<p>{post.data.description}</p>
									<div class="post-meta">
										<span class="category" data-cat={post.data.category}>{post.data.category}</span>
										<span class="divider">·</span>
										<time><FormattedDate date={post.data.pubDate} /></time>
										<span class="divider">·</span>
										<span>{estimateReadingTime(post.body)} 分钟</span>
									</div>
									<div class="post-taxonomy">
										{post.data.tags.slice(0, 4).map((tag) => (
											<span>{tag}</span>
										))}
									</div>
								</div>
							</a>
						</li>
					))
				}
			</ul>
			<div class="shortcut-links">
				<a href="/categories/">按分类浏览</a>
				<a href="/tags/">按标签浏览</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
