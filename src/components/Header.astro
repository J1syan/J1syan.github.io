---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/categories/">分类</HeaderLink>
			<HeaderLink href="/tags/">标签</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
		<div class="header-right">
			<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
				<span class="theme-icon light">☀</span>
				<span class="theme-icon dark">🌙</span>
			</button>
			<a class="github-link" href="https://github.com/J1syan" target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</nav>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const html = document.documentElement;

	function applyTheme(theme) {
		if (theme === 'dark') {
			html.setAttribute('data-theme', 'dark');
		} else {
			html.removeAttribute('data-theme');
		}
	}

	const savedTheme = localStorage.getItem('theme');
	if (savedTheme) {
		applyTheme(savedTheme);
	} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
		applyTheme('dark');
	}

	themeToggle?.addEventListener('click', () => {
		const current = html.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		applyTheme(next);
		localStorage.setItem('theme', next);
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid rgb(var(--gray-light));
		background: rgba(var(--background), 0.92);
		backdrop-filter: blur(12px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(1080px, calc(100% - 2rem));
		margin: 0 auto;
		min-height: 64px;
	}

	.site-title {
		flex: 0 0 auto;
		color: rgb(var(--black));
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		flex-wrap: wrap;
	}

	nav a {
		padding: 0.5rem 0.65rem;
		color: rgb(var(--gray-dark));
		border-radius: 8px;
		text-decoration: none;
	}

	nav a:hover,
	nav a.active {
		color: rgb(var(--accent));
		background: rgba(var(--accent), 0.08);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.github-link {
		font-size: 0.9rem;
	}

	.theme-toggle {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		border: 1px solid rgb(var(--border));
		background: transparent;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.theme-toggle:hover {
		background: rgba(var(--accent), 0.08);
		border-color: rgba(var(--accent), 0.2);
	}

	.theme-icon.dark {
		display: none;
	}

	:global([data-theme="dark"]) .theme-icon.light {
		display: none;
	}

	:global([data-theme="dark"]) .theme-icon.dark {
		display: inline;
	}

	@media (max-width: 720px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.35rem;
			padding: 0.8rem 0;
		}

		.internal-links {
			justify-content: flex-start;
		}

		.header-right {
			display: none;
		}
	}
</style>
