---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryUrl, tagUrl } from '../lib/blog';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, category, tags, heroImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="post-page">
			<!-- Reading Progress -->
			<div class="reading-progress" id="reading-progress"></div>

			<article>
				{
					heroImage && (
						<div class="hero-image">
							<img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt="" />
						</div>
					)
				}
				<header class="post-header">
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						<span>·</span>
						<a href={categoryUrl(category)}>{category}</a>
					</div>
					<h1>{title}</h1>
					<p>{description}</p>
					{
						updatedDate && (
							<p class="updated-date">
								更新于 <FormattedDate date={updatedDate} />
							</p>
						)
					}
					{
						tags.length > 0 && (
							<div class="tag-list">
								{tags.map((tag) => (
									<a href={tagUrl(tag)}>#{tag}</a>
								))}
							</div>
						)
					}
				</header>

				<!-- TOC (auto-generated by JS) -->
				<nav class="toc-sidebar" id="toc-sidebar" aria-label="目录"></nav>

				<div class="prose" id="article-prose">
					<slot />
				</div>
			</article>
		</main>

		<!-- Back to Top -->
		<button class="back-to-top" id="back-to-top" aria-label="返回顶部">↑</button>

		<Footer />
		<script>
			// Reading Progress
			const progressBar = document.getElementById('reading-progress');
			function updateProgress() {
				const scrollTop = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
				if (progressBar) progressBar.style.width = progress + '%';
			}
			window.addEventListener('scroll', updateProgress, { passive: true });
			updateProgress();

			// Back to Top
			const backToTop = document.getElementById('back-to-top');
			function toggleBackToTop() {
				if (!backToTop) return;
				if (window.scrollY > 400) {
					backToTop.classList.add('visible');
				} else {
					backToTop.classList.remove('visible');
				}
			}
			window.addEventListener('scroll', toggleBackToTop, { passive: true });
			backToTop?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// Copy Code Button
			function addCopyButtons() {
				const codeBlocks = document.querySelectorAll('pre');
				codeBlocks.forEach((pre) => {
					if (pre.querySelector('.copy-btn')) return;
					const btn = document.createElement('button');
					btn.className = 'copy-btn';
					btn.textContent = '复制';
					btn.addEventListener('click', () => {
						const code = pre.querySelector('code');
						if (!code) return;
						navigator.clipboard.writeText(code.textContent || '').then(() => {
							btn.textContent = '已复制';
							btn.classList.add('copied');
							setTimeout(() => {
								btn.textContent = '复制';
								btn.classList.remove('copied');
							}, 2000);
						});
					});
					pre.appendChild(btn);
				});
			}
			document.addEventListener('DOMContentLoaded', addCopyButtons);

			// TOC generation
			function generateTOC() {
				const toc = document.getElementById('toc-sidebar');
				const prose = document.getElementById('article-prose');
				if (!toc || !prose) return;

				const headings = prose.querySelectorAll('h2, h3');
				if (headings.length === 0) {
					toc.style.display = 'none';
					return;
				}

				toc.innerHTML = '<h4>目录</h4>';
				const ul = document.createElement('ul');

				headings.forEach((heading, index) => {
					const id = 'heading-' + index;
					heading.id = id;
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = '#' + id;
					a.textContent = heading.textContent || '';
					a.classList.add(heading.tagName.toLowerCase());
					a.addEventListener('click', (e) => {
						e.preventDefault();
						heading.scrollIntoView({ behavior: 'smooth' });
					});
					li.appendChild(a);
					ul.appendChild(li);
				});

				toc.appendChild(ul);

				// Active section tracking
				function updateActive() {
					let current: Element | null = null;
					for (const h of Array.from(headings)) {
						const rect = h.getBoundingClientRect();
						if (rect.top <= 120) {
							current = h;
						} else {
							break;
						}
					}
					ul.querySelectorAll('a').forEach((a) => a.classList.remove('active'));
					if (current) {
						const activeLink = ul.querySelector('a[href="#' + (current as HTMLElement).id + '"]');
						activeLink?.classList.add('active');
					}
				}
				window.addEventListener('scroll', updateActive, { passive: true });
			}
			document.addEventListener('DOMContentLoaded', generateTOC);
		</script>
		<script>
			import { initMasteryTracker } from '../scripts/mastery-tracker';
			document.addEventListener('DOMContentLoaded', () => initMasteryTracker());
		</script>
	</body>
</html>

<style>
	.post-page {
		width: min(860px, calc(100% - 2rem));
	}

	.hero-image {
		margin-bottom: 2rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		border-radius: 12px;
		box-shadow: var(--shadow-card);
	}

	.post-header {
		margin-bottom: 2.5rem;
	}

	.post-header h1 {
		margin: 0.5rem 0 0.75rem;
	}

	.post-header p {
		max-width: 720px;
		margin: 0 0 1rem;
		color: rgb(var(--gray));
	}

	.post-meta,
	.updated-date {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.post-meta a {
		color: rgb(var(--accent));
		font-weight: 500;
	}

	.post-meta a:hover {
		color: rgb(var(--accent-strong));
	}

	/* TOC */
	.toc-sidebar {
		position: fixed;
		top: 80px;
		right: 2rem;
		width: 220px;
		max-height: calc(100vh - 120px);
		overflow-y: auto;
		padding: 1rem;
		border: 1px solid rgb(var(--border));
		border-radius: 12px;
		background: rgb(var(--surface));
		box-shadow: var(--shadow-sm);
		font-size: 0.85rem;
		z-index: 100;
	}

	.toc-sidebar h4 {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
	}

	.toc-sidebar ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-sidebar li {
		margin: 0.15rem 0;
	}

	.toc-sidebar a {
		display: block;
		padding: 0.3rem 0.5rem;
		border-radius: 6px;
		color: rgb(var(--gray));
		font-size: 0.82rem;
		line-height: 1.4;
		text-decoration: none;
		transition: all var(--transition);
	}

	.toc-sidebar a:hover,
	.toc-sidebar a.active {
		color: rgb(var(--accent));
		background: rgba(var(--accent), 0.06);
	}

	.toc-sidebar a.active {
		font-weight: 600;
	}

	.toc-sidebar a.h3 {
		padding-left: 1rem;
		font-size: 0.78rem;
	}

	/* Hide TOC on small screens */
	@media (max-width: 1200px) {
		.toc-sidebar {
			display: none;
		}
	}
</style>

<!-- Mastery Tracker 样式必须用 is:global -->
<style is:global>
	#mastery-toolbar {
		margin-bottom: 1.5rem;
		padding: 1rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 10px;
	}

	.mastery-progress {
		height: 8px;
		background: rgb(var(--gray-light));
		border-radius: 4px;
		overflow: hidden;
		margin-bottom: 0.6rem;
	}

	.mastery-progress-fill {
		height: 100%;
		width: 0%;
		background: rgb(var(--accent));
		border-radius: 4px;
		transition: width 0.4s ease;
	}

	.mastery-toolbar-info {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.mastery-count {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		font-weight: 500;
	}

	.mastery-toggle {
		font-size: 0.85rem;
		padding: 0.3rem 0.75rem;
		border: 1px solid rgb(var(--border));
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		transition: all var(--transition);
	}

	.mastery-toggle:hover {
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
	}

	.problem-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.mastery-check {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		cursor: pointer;
	}

	.mastery-check input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}

	.mastery-check .checkmark {
		width: 18px;
		height: 18px;
		border: 2px solid rgb(var(--gray-light));
		border-radius: 4px;
		transition: all var(--transition);
	}

	.mastery-check input:checked + .checkmark {
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
	}

	.mastery-check input:checked + .checkmark::after {
		content: '';
		position: absolute;
		left: 5px;
		top: 2px;
		width: 5px;
		height: 9px;
		border: solid white;
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}

	.mastery-check:hover .checkmark {
		border-color: rgb(var(--accent));
	}

	.problem-heading.mastered .problem-title {
		text-decoration: line-through;
		color: rgb(var(--gray));
		opacity: 0.7;
	}

	.problem-section.mastered {
		opacity: 0.5;
		transition: opacity 0.3s;
	}

	.problem-section.mastered:hover {
		opacity: 0.85;
	}

	.prose.hide-mastered .problem-section.mastered {
		display: none;
	}

	.prose .mermaid {
		display: flex;
		justify-content: center;
		margin: 1.5rem 0;
		overflow-x: auto;
	}

	.prose pre[data-language="mermaid"] {
		background: transparent !important;
		padding: 0;
		border-radius: 0;
		overflow: visible;
	}
</style>
